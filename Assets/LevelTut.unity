  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCSystem
  dialougePanel: {fileID: 1959464110}
  dialougeText: {fileID: 16673134}
  dialouge:
  - Hello! I am Jorma and welcome to jail.
  - 'You probably know how to walk. You know cos you''re here. '
  - But i want to tell you about other buttons and how you will play this game.
  - You can dash by pressing space bar, interact with E and attack with left mousebutton.
  - Your goal is to find a key on the map and find the door and go through it. You
    can also find other weapons on the map.
  - now i want you to try you're weapon and kill those enemies behind me and get
    the key!!!
  - Now go away.
  contButton: {fileID: 600810758}
  wordSpeed: 0.03
